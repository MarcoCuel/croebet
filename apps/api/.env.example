APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Substitua SUA_SENHA pela mesma POSTGRES_PASSWORD do .env da raiz.
DATABASE_URL=postgresql://croebet:SUA_SENHA@127.0.0.1:5432/croebet_development
# Em produção, migrations usam um usuário diferente do runtime.
# DATABASE_MIGRATION_URL=
# Reset desabilitado por padrão. Copie o destino exato e confirme o nome somente para development/test.
# DB_RESET_ALLOWED_URL=
# DB_RESET_CONFIRM=


WEB_ORIGIN=http://localhost:3000
# Apenas development/test: origens adicionais exatas, separadas por vírgula (sem barra final).
# DEV_WEB_ORIGINS=http://192.168.1.2:3000
# Gere um segredo local: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Avatares e biblioteca de mídia compartilham o adaptador/bucket, com prefixos separados.
# Produção usa S3 privado ou diretório persistente absoluto com opt-in explícito.
# PRODUCTION_LOCAL_IMAGES=true
# Mídia local usa a pasta media ao lado do diretório de avatares.
AVATAR_STORAGE=local
AVATAR_LOCAL_DIR=.data/avatars
# AVATAR_STORAGE=s3
# S3_REGION=auto
# S3_ENDPOINT=https://endpoint-do-provedor
# S3_BUCKET=croebet-avatars
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Limite operacional por processo; aumentar somente após medir carga.
REALTIME_MAX_CONNECTIONS=200

# Somente produção, API em loopback, Next também em loopback atrás de cloudflared.
# TRUST_CLOUDFLARE_PROXY=true
