{
  "name": "@croebet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @croebet/shared build && node --env-file-if-exists=.env --watch --experimental-strip-types src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts seed",
    "db:reset": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts reset",
    "test:guards": "node --test tests/reset-guard.test.mjs"
  },
  "dependencies": {
    "@croebet/shared": "workspace:*",
    "fastify": "^5.0.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0",
    "@fastify/cookie": "^11.0.0",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "drizzle-kit": "^0.31.0",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.1"
  }
}
